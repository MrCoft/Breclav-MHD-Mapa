{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        // "vite/client" alongside "node": `e2e/` (Node-side Playwright specs, compiled under this
        // program) now imports runtime code from `src/domain/` (finding C1's fix, deriving a
        // moment from the committed data via the app's own `vehiclesAt`), which references
        // `import.meta.env.DEV` — a Vite-only augmentation of `ImportMeta`, otherwise unknown to
        // this Node-flavoured program. Same cross-boundary friction as docs/known-bugs.md entry 3,
        // in the opposite direction (there it was `scripts/` picking up DOM lib via `tests/`).
        "types": ["node", "vite/client"],

        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts", "e2e"]
}
